# ---------------------------------------------------------------
# Alive Bot — Configuração do Bot de Produção
# ---------------------------------------------------------------

# Porta do servidor local (padrão 3000)
PORT=3000

# 1) Configuração do Bot da Twitch (para rodar no Node 24/7 sem navegador)
TWITCH_CHANNEL=
TWITCH_BOT_NICK=
TWITCH_BOT_TOKEN=oauth:
AUTO_START_BOT=1

# 2) Client ID do seu app na Twitch (dev.twitch.tv) — opcional
TWITCH_CLIENT_ID=

# 3) Segredo opcional para proteção da rota /api/state
ALIVE_SECRET=

# 3.1) Chave da API de IA (Groq) usada pelo bot no SERVIDOR (!ia no chat).
# O painel usa a chave digitada nele (localStorage, não sincroniza);
# sem esta env, o !ia do backend funciona apenas se o painel estiver aberto.
GROQ_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=qwen/qwen3.8-27b

# 4) Persistência remota opcional (Vercel KV / Upstash Redis)
# Caso não configurado, o bot persiste localmente em data/state.json
KV_REST_API_URL=
KV_REST_API_TOKEN=
BLOB_READ_WRITE_TOKEN=
